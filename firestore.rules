rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if a user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Admin access granted to new admin email as well as legacy email
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@vegchennaisrilalitha.co.uk' ||
        request.auth.token.email == 'domealuk79812@gmail.com'
      );
    }

    // 1. Menu Items: Customers can view the menu, ONLY Admin can add/edit/delete
    match /menuItems/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Users: Customers can ONLY create and read their OWN profile. Admin can see everyone.
    match /users/{userId} {
      allow read, write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // 3. Orders: Customers can ONLY see and place their OWN orders. Admin manages all orders.
    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // 4. Settings: Customers can read public settings, ONLY Admin can edit
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Wallet transactions and gift cards
    match /wallet_transactions/{document=**} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /gift_cards/{document=**} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if isAdmin();
    }

  }
}
